export pub const PI = 3.14159265358979;

func normalizeRadians(x) {
    var twoPi = 2.0 * PI;
    while x > PI {
        x = x - twoPi;
    }
    while x < -PI {
        x = x + twoPi;
    }
    return x;
}

export pub func sin(x) {
    var y = normalizeRadians(x);
    var term = y;
    var result = y;

    term = term * (-1.0) * y * y / (2.0 * 3.0);
    result = result + term;

    term = term * (-1.0) * y * y / (4.0 * 5.0);
    result = result + term;

    term = term * (-1.0) * y * y / (6.0 * 7.0);
    result = result + term;

    term = term * (-1.0) * y * y / (8.0 * 9.0);
    result = result + term;

    term = term * (-1.0) * y * y / (10.0 * 11.0);
    result = result + term;

    return result;
}

export pub func cos(x) {
    var y = normalizeRadians(x);
    var term = 1.0;
    var result = 1.0;

    term = term * (-1.0) * y * y / (1.0 * 2.0);
    result = result + term;

    term = term * (-1.0) * y * y / (3.0 * 4.0);
    result = result + term;

    term = term * (-1.0) * y * y / (5.0 * 6.0);
    result = result + term;

    term = term * (-1.0) * y * y / (7.0 * 8.0);
    result = result + term;

    term = term * (-1.0) * y * y / (9.0 * 10.0);
    result = result + term;

    return result;
}

export pub func tan(x) {
    return sin(x) / cos(x);
}

export pub func toRadians(deg) {
    return deg * PI / 180.0;
}

export pub func toDegrees(rad) {
    return rad * 180.0 / PI;
}
